{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "punchme-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "punchme-frontend-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5199"],
      "port": 5199,
      "autoPort": true
    },
    {
      "name": "punchme-backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "../punchme-backend", "python", "manage.py", "runserver", "127.0.0.1:8000"],
      "port": 8000
    }
  ]
}
