{
  "name": "punchme-promo-video",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The PunchMe promo video, rendered with Remotion from the app's own components and copy.",
  "scripts": {
    "studio": "remotion studio",
    "stills": "node scripts/stills.ts",
