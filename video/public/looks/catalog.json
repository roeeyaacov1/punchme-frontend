[
  {
    "id": "barber-gold-scissors",
    "niche": "barber",
    "name": "Gold Scissors Card",
    "description": "Scissors in gold circles on a dark panel with sparkles, the count on top",
    "stamps_required": 10,
    "reward_description": "התספורת העשירית חינם",
    "background_color": "#0E1120",
    "foreground_color": "#FFFFFF",
    "label_color": "#C88A11",
    "design": {
      "stamp": {
        "color": "#C88A11",
        "glyph": "scissors",
        "style": "badge",
        "sticker": "scissors"
      },
      "fields": [
        {
          "label": "שם",
          "binding": "person.displayName",
          "section": "SECONDARY_FIELDS",
          "alignment": "LEFT",
          "default_value": ""
        },
        {
          "label": "תספורות",
          "binding": "members.member.points",
          "section": "HEADER_FIELDS",
          "alignment": "RIGHT",
          "default_value": "0",
          "change_message": "עודכנו החותמות שלך: %@"
        },
        {
          "label": "מידע",
          "binding": "universal.info",
          "section": "BACK_FIELDS",
          "alignment": "NATURAL",
          "default_value": "התספורת העשירית חינם"
        }
      ],
      "barcode": {
        "format": "QR",
        "payload": "${pid}",
        "alt_text": ""
      },
      "pattern": "none",
      "wallpaper": "sparkles",
      "panel_color": "#1A1F38",
      "stamps_place": "header",
      "stamps_format": "fraction",
      "default_language": "HE"
    },
    "options": {
      "style": "badge",
      "mark": "none",
      "sticker": "scissors",
      "tint": false,
      "panel_color": "#1A1F38",
      "wallpaper": "sparkles",
      "stamps_place": "header",
      "stamps_format": "fraction",
      "logo_text": false
    },
    "pictures": {
      "strip": "looks/barber-gold-scissors-strip.png",
      "hero": "looks/barber-gold-scissors-hero.png"
    }
  },
