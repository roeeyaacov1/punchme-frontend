VITE_API_ORIGIN=http://127.0.0.1:8000
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_MAPS_API_KEY=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
# Must match the backend's OTP_REQUIRED. "false" drops the SMS-code step from
# the join flow and enrolls straight from the details form. Unset = true.
VITE_OTP_REQUIRED=true
# Enables the manual add/remove-stamp control on the customers table. Its
# endpoint (POST /api/businesses/{id}/cards/{card_id}/stamps) shipped in
# punchme-backend 32a1743; set false if you point at an older deploy. Unset =
# false, and Vite reads it at BUILD time — every deploy must set it or the
# control ships greyed out. See docs/customers-backend-issues.md.
VITE_STAMP_ADJUST_ENABLED=true
